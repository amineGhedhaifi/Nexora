enum ContactMessageStatus {
  UNREAD
  READ
  RESOLVED
}

model ContactMessage {
  id        String               @id @default(uuid())
  name      String
  email     String
  topic     ContactTopic
  message   String
  status    ContactMessageStatus @default(UNREAD)
  createdAt DateTime             @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
}

enum ContactTopic {
  GENERAL_INQUIRY
  PRODUCT_QUESTION
  ORDER_SUPPORT
  SHIPPING_DELIVERY
  RETURNS_REFUNDS
  TECHNICAL_ISSUE
  OTHER
}